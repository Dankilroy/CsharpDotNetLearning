double a = 42.6;
float b = 18.8f;
double c = a + b;
Console.WriteLine(c);
// This will equal 61.4 but to a longer number. Instead use Decimal to get the exact number.

decimal a = 42.6m;
decimal b = 18.8m;
decimal c = a + b;
Console.WriteLine($"The answer to this is {c}");
