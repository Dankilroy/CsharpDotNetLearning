// The Trim() method is used to remove any leading or trailing whitespace from the string. In this case, it removes the extra spaces before and after "David!" so that the output is cleaner.
// Can also be done for Start and end of the string using TrimStart() and TrimEnd() methods respectively.
// The Trim() method is useful when you want to ensure that the string is formatted correctly without any unnecessary spaces. It helps in cleaning up user input or formatting strings for display purposes.


string friends = "Sage, David,";

Console.WriteLine(friends.Replace("David", "Michael"));

// The Replace() method is used to replace all occurrences of a specified substring with another substring. In this case, it replaces "David" with "Michael" in the string "Sage, David,". The output will be "Sage, Michael,". This is useful for updating or modifying strings based on certain criteria or user input.
// The Replace() method is commonly used for string manipulation tasks, such as updating names, correcting typos, or changing specific words in a text.
// It allows you to easily modify strings without having to manually search and replace each occurrence.

string friends = "Sage, David,";
Console.WriteLine(friends);
friends = friends.Replace("David", "Michael");
Console.WriteLine(friends);

