//do loop
int counter = 0;
do
{
    Console.WriteLine(counter);
    counter++;
}

while (counter < 5);

// This reads better as it will run the code inside the do loop at least once before checking the condition. The output will be the same as the while loop, printing the values from 0 to 4. The difference is that even if the condition is false initially, the code inside the do block will still execute once before checking the condition.


