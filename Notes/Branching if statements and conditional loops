ifs in loops
for (int i = 0; i < 5; i++)
{
    if (i == 6)
        Console.WriteLine(i); // body of the loop
    else
        Console.WriteLine("Not 6"); // body of the loop
}

nested for loops
for (int i = 0; i < 5; i++)
{
    for (int j = 0; j < 5; j++)
    {
        Console.WriteLine($"i: {i}, j: {j}"); // body of the loop
    }
}

