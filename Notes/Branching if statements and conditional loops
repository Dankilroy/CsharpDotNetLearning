if ((a + b + c > 10) && (a == 5))
{
    Console.WriteLine("MyTest is greater than 10 and a is equal to 5");
}
else if ((a + b + c > 10) || a == 5)
{
    Console.WriteLine("MyTest is greater than 10 or a is equal to 5");
}
else
{
    Console.WriteLine("MyTest is not greater than 10 and a is not equal to 5");
}
//composit if statements above where its a if and a and statement double && and a or statement double ||. The first if statement checks if the sum of a, b, and c is greater than 10 and if a is equal to 5. If both conditions are true, it prints "MyTest is greater than 10 and a is equal to 5". If not, it checks if either condition is true using the || operator. If either condition is true, it prints "MyTest is greater than 10 or a is equal to 5". If neither condition is met, it prints "MyTest is not greater than 10 and a is not equal to 5". In this case, since c is equal to 8 (5 + 3), the output will be "MyTest is not greater than 10 and a is not equal to 5".
//
// The && operator is used to check if both conditions are true, while the || operator is used to check if at least one condition is true. This allows you to create more complex conditional statements in your code.



