// Declaration with initialization
int[] numbers = new int[5]; // Creates array of 5 integers (all 0)
string[] names = new string[3]; // Creates array of 3 strings (all null)

// Declaration with values
int[] scores = new int[] { 75, 89, 95, 77, 82 };
string[] days = { "Monday", "Tuesday", "Wednesday" }; // Shorthand syntax

// Accessing elements (zero-based index)
int secondScore = scores[1]; // Gets 89
names[0] = "Alice"; // Assigns "Alice" to first element

// Array properties
int length = scores.Length; // Gets 5

// Multi-dimensional arrays
int[,] matrix = new int[3, 2]; // 3 rows, 2 columns
int[,] grid = { { 1, 2 }, { 3, 4 }, { 5, 6 } }; // 3x2 matrix
matrix[0, 1] = 10; // Sets element at row 0, column 1

